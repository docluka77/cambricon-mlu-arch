# =============================================================================
# File: formal/prove_mfu_dma.ys
# Description: Yosys 0.60 Sequential SAT Proof Script for mlu_mfu_dma_engine
# =============================================================================
read_verilog -sv -formal -Irtl rtl/mlu_pkg.sv rtl/mlu_mfu_dma_engine.sv formal/mlu_mfu_dma_engine_formal.sv
prep -top mlu_mfu_dma_engine_formal
flatten
async2sync
chformal -lower
opt -full
sat -verify -seq 10 -set-init-zero -prove-asserts -set-assumes -show-ports
