# =============================================================================
# File: formal/prove_nram_wram_mpu.ys
# Description: Yosys 0.60 Sequential SAT Proof Script for NRAM, WRAM, & MPU SRAM
# =============================================================================
read_verilog -sv -formal -Irtl -Isram_ip rtl/mlu_pkg.sv sram_ip/mlu_sram_secded_ecc.sv sram_ip/mlu_sram_sp_macro.sv rtl/mlu_nram_banked_scratchpad.sv rtl/mlu_wram_weight_buffer.sv rtl/mlu_mpu_shared_sram.sv formal/mlu_nram_wram_mpu_formal.sv
prep -top mlu_nram_wram_mpu_formal
memory -nomap
flatten
async2sync
chformal -lower
opt -full
memory_map
opt -full
sat -verify -seq 8 -set-init-zero -prove-asserts -set-assumes -show-ports
