# =============================================================================
# File: formal/prove_mlu_link.ys
# Description: Yosys 0.60 Sequential SAT Proof Script for MLU-Link NoC & C2C PCS
# =============================================================================
read_verilog -sv -formal -Irtl rtl/mlu_pkg.sv rtl/mlu_link_noc_router.sv rtl/mlu_c2c_serdes_pcs.sv formal/mlu_link_noc_pcs_formal.sv
prep -top mlu_link_noc_pcs_formal
memory -nomap
flatten
chformal -lower
opt -full
memory_map
opt -full
async2sync
opt -full
sat -verify -seq 8 -set-init-zero -prove-asserts -set-assumes -show-ports
